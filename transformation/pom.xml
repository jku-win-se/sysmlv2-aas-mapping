<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jku-win-se</groupId>
    <artifactId>sysmlv2-aas-mapping</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>transformation</artifactId>
  <packaging>jar</packaging>
  <name>SysML v2 → AAS Transformation</name>
  <description>
    EMF-based model-to-model transformation from SysML v2 XMI to AAS XMI.
    The .qvto files document the mapping rules (Table 1-3 from JSS 2026);
    RunTransformation.java is the standalone CLI executor.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.jku-win-se</groupId>
      <artifactId>aas-metamodel</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <!-- EMF XMI support for loading/saving model resources -->
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <version>2.16.0</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>11</source>
          <target>11</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      <!-- Fat JAR so the runner can be invoked with a single -jar flag -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>RunTransformation</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <id>make-fat-jar</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
